# Copy this file to .env and adjust as needed. Everything is optional.

# Card Ladder credentials — OPTIONAL. Only used to pre-fill the login form
# when you run `npm run login`. The recommended flow is to leave these blank
# and type your credentials yourself in the browser window that opens.
# Your login session is saved in the local ./profile folder either way.
CL_EMAIL=
CL_PASSWORD=

# Port for the local web UI
PORT=4000

# Run the sync browser headless. Keep false — a visible browser is more
# reliable against Cloudflare bot detection, and this app runs on your desktop.
HEADLESS=false

# Ladder crawl tuning. The sync pages through the grade-filtered Ladder API.
# CRAWL_LIMIT = hits requested per page (auto-lowered if the server caps it).
# PAGE_DELAY_MS = polite delay between page requests (per page, not per card).
CRAWL_LIMIT=100
PAGE_DELAY_MS=1200

# Set to 1 to use the built-in mock data source instead of Card Ladder
# (for developing/testing the app without a Card Ladder account)
MOCK_CL=

# Set to 1 during sync to also dump ALL captured network traffic to
# captures/<timestamp>/ (useful for debugging parsers)
DISCOVERY=

# ===== Marketplace watcher =====

# How often (minutes) to automatically check marketplaces for watched cards
# while the server is running. 0 = only when you click "Check now".
WATCH_INTERVAL_MIN=30

# Lead time (minutes) for the "watched auctions ending soon" reminder push.
# Default 1440 = 24 hours before an auction closes.
WATCH_REMIND_MIN=1440

# Comma-separated source adapters to check. Available:
#   ebay      - official API (needs keys below); no browser
#   shopify   - any Shopify card shop via SHOPIFY_SHOPS; no browser
#   fanatics  - Fanatics Collect (ex-PWCC) GraphQL; no browser
#   comc      - COMC RSS SearchFeed; no browser
#   goldin    - Goldin: auctions AND fixed-price; OPENS THE BROWSER
#   cia       - Collector Investor Auctions; no browser
#   classic   - Classic Auctions (Montreal, CAD); no browser
#   miller    - Miller & Miller (Ontario, CAD); no browser
#   hibid     - HiBid Canada aggregator; OPENS THE BROWSER (Cloudflare)
#   heritage  - Heritage Auctions; OPENS THE BROWSER (blocks plain clients)
#   myslabs   - MySlabs; OPENS THE BROWSER (Cloudflare)
#   pristine  - Pristine: BOTH venues — auctions (pristineauction.com,
#               OPENS THE BROWSER) and the fixed-price marketplace
#               (pristinemarketplace.com)
#   catawiki  - Catawiki (EU); OPENS THE BROWSER (PerimeterX)
# Browser-based sources share the same visible Chromium profile as Sync and
# wait their turn while a Card Ladder sync is running.
# Before enabling a scraped source, verify it works from your machine:
#   npm run test-source -- <source> "jordan psa 10"
# Scraped sites change and some block datacenter/VPN IPs — a failing source
# never breaks the others (it's marked failed for that run and retried).
WATCH_SOURCES=ebay,fanatics,comc

# eBay Browse API credentials — create a (free) developer account at
# https://developer.ebay.com, make a production keyset, and paste the App ID
# (client id) + Cert ID (client secret) here. Without these the ebay source
# reports an error and is skipped.
# API budget: the free tier allows 5,000 calls/day. Each check spends roughly
# (watches × marketplaces) calls — e.g. 50 watches × 6 marketplaces × 8
# checks/day ≈ 2,400. If you watch many more cards, raise WATCH_INTERVAL_MIN.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# 'production' or 'sandbox' (sandbox data is junk — only for wiring tests)
EBAY_ENV=production
# Which eBay marketplaces to search (one API call each per watch per check).
EBAY_MARKETPLACES=EBAY_US,EBAY_CA,EBAY_GB,EBAY_DE,EBAY_FR,EBAY_IT

# Generic Shopify-shop source: comma-separated shop domains, optionally with
# a currency suffix (defaults to CAD). Example:
# SHOPIFY_SHOPS=flipcollect.com:CAD,www.mintink.ca:CAD,overtimesportscards.ca:CAD
SHOPIFY_SHOPS=

# Push notifications via ntfy.sh: install the ntfy app on your phone,
# subscribe to a private topic name (make it long and random), and put that
# topic here. Empty = notifications disabled.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
