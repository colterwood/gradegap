# Copy this file to .env and adjust as needed. Everything is optional.

# Card Ladder credentials — OPTIONAL. Only used to pre-fill the login form
# when you run `npm run login`. The recommended flow is to leave these blank
# and type your credentials yourself in the browser window that opens.
# Your login session is saved in the local ./profile folder either way.
CL_EMAIL=
CL_PASSWORD=

# Port for the local web UI
PORT=4000

# Run the sync browser headless. Keep false — a visible browser is more
# reliable against Cloudflare bot detection, and this app runs on your desktop.
HEADLESS=false

# Delay between page navigations during sync (milliseconds, jittered range)
RATE_MIN_MS=3000
RATE_MAX_MS=7000

# Set to 1 to use the built-in mock data source instead of Card Ladder
# (for developing/testing the app without a Card Ladder account)
MOCK_CL=

# Set to 1 during sync to also dump ALL captured network traffic to
# captures/<timestamp>/ (useful for debugging parsers)
DISCOVERY=
